{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"extraKnownMarketplaces": {
		"svelte": {
			"source": { "source": "github", "repo": "sveltejs/ai-tools" }
		},
		"better-auth-agent-skills": {
			"source": { "source": "github", "repo": "better-auth/skills" }
		}
	},
	"enabledPlugins": {
		"svelte@svelte": true,
		"auth-skills@better-auth-agent-skills": true,
		"security-guidance@claude-plugins-official": true
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\""
					}
				]
			}
		]
	}
}
