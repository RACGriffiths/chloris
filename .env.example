# Chloris configuration. Copy this file to .env and fill it in.
# Every variable is described in docs/spec.md (Configuration). Empty values count as unset.

# Required. The public HTTPS address people use. For `npm run dev`: http://localhost:5173
ORIGIN=http://localhost:5173
# Required. At least 32 random characters, e.g. from: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the Node server listens. Defaults: 3000 and 0.0.0.0.
# PORT=3000
# HOST=0.0.0.0

# Storage. Defaults: ./data, and photos in $DATA_DIR/photos. The Docker image uses /data.
# PHOTOS_DIR can be a mounted drive. If set, the folder must already exist: Chloris won't start
# without it, so photos never end up on the local disk when the drive isn't mounted.
# DATA_DIR=./data
# PHOTOS_DIR=

# Maximum request size, read by `npm start`. Photo uploads need at least 21M; the default, 512K,
# is too small even for a photo resized in the browser. The Docker image sets 25M.
BODY_SIZE_LIMIT=25M

# Behind a reverse proxy: the header carrying the visitor's IP and how many trusted proxies
# are in front. Behind one Caddy: X-Forwarded-For and 1. These headers can be spoofed, so
# check the values against your real proxy chain.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Email (optional). Leave SMTP_HOST unset to switch email off, and with it emailed sign-in links
# and the daily digest.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Chloris <plants@example.com>

# Web push (optional). Push is off without all three.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Days a deleted photo's files stay on disk before the server removes them. Default 30. If you
# back up the photos separately from the database (host snapshots, say), keep it longer than
# the time between the two.
# PHOTO_DELETE_GRACE_DAYS=30
